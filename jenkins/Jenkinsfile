pipeline {

    agent any

    environment {

        AIRFLOW_URL = "http://host.docker.internal:8080/api/v1"

        DAG_ID = "travel_pipeline"

        API_IMAGE = "voyage-api:${BUILD_NUMBER}"

        STREAMLIT_IMAGE = "voyage-streamlit:${BUILD_NUMBER}"

        K8S_NAMESPACE = "voyage-analytics"

        K8S_DEPLOYMENT = "voyage-api"

        K8S_STREAMLIT_DEPLOYMENT = "voyage-streamlit"

        K8S_SERVICE = "voyage-api-service"
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {

        stage('Checkout Source') {
            steps {
                checkout scm
            }
        }

        stage('Sync Repository to Shared Workspace') {

            steps {

                sh '''

                echo "=========================================="
                echo "Synchronizing Repository"
                echo "=========================================="

                echo "Jenkins Workspace : $WORKSPACE"

                mkdir -p /workspace

                echo "Cleaning Shared Workspace..."

                rm -rf /workspace/*

                echo "Copying Repository..."

                cp -a "$WORKSPACE"/. /workspace/

                echo
                echo "Shared Workspace Contents"

                ls -la /workspace

                '''

            }
        }

        stage('Project Information') {

            steps {

                sh '''

                echo "=========================================="
                echo "Voyage Analytics MLOps Pipeline"
                echo "=========================================="

                echo "Workspace : $(pwd)"
                echo "Branch    : ${BRANCH_NAME}"
                echo "Build No  : ${BUILD_NUMBER}"
                echo "Image     : ${API_IMAGE}"
                echo "Frontend  : ${STREAMLIT_IMAGE}"

                echo
                docker --version
                git --version
                curl --version | head -1
                jq --version
                kubectl version --client
                minikube version

                '''
            }
        }

        stage('Verify Kubernetes') {

            steps {

                sh '''

                echo "Current Context"

                kubectl config current-context

                echo

                echo "Cluster Nodes"

                kubectl get nodes

                '''
            }
        }


        stage('Trigger Airflow DAG') {

            steps {

                script {

                    env.DAG_RUN_ID = sh(

                        script: '''
                        curl -s \
                        -u admin:admin \
                        -H "Content-Type: application/json" \
                        -X POST \
                        ${AIRFLOW_URL}/dags/${DAG_ID}/dagRuns \
                        -d '{}' \
                        | jq -r '.dag_run_id'
                        ''',

                        returnStdout: true

                    ).trim()

                    echo "Triggered DAG Run ID: ${env.DAG_RUN_ID}"
                }
            }
        }


        stage('Wait for DAG Completion') {

            steps {

                script {

                    timeout(time: 30, unit: 'MINUTES') {

                        waitUntil {

                            def status = sh(

                                script: """
                                curl -s \
                                -u admin:admin \
                                ${AIRFLOW_URL}/dags/${DAG_ID}/dagRuns/${env.DAG_RUN_ID} \
                                | jq -r '.state'
                                """,

                                returnStdout: true

                            ).trim()

                            echo "Current DAG State : ${status}"

                            if (status == "success") {
                                return true
                            }

                            if (status == "failed") {
                                error("Airflow DAG Failed")
                            }

                            sleep 20

                            return false
                        }
                    }
                }
            }
        }

        stage('Build Voyage Application Images') {

            steps {

                dir('/workspace') {

                    sh '''

                    echo "====================================="
                    echo "Building Voyage Application Docker Images"
                    echo "====================================="

                    pwd

                    ls

                    docker build \
                        -f api/Dockerfile \
                        -t ${API_IMAGE} \
                        .

                    docker build \
                        -f streamlit_app/Dockerfile \
                        -t ${STREAMLIT_IMAGE} \
                        .

                    echo
                    docker images | grep voyage-

                    '''

                }

            }

        }

        stage('Load Image into Minikube') {
            steps {
                sh '''
                docker save ${API_IMAGE} ${STREAMLIT_IMAGE} | docker exec -i minikube docker load
                '''
            }
        }

        stage('Deploy to Kubernetes') {

            steps {

                sh '''

                echo "====================================="
                echo "Deploying Kubernetes Resources"
                echo "====================================="

                export API_IMAGE_TAG=${BUILD_NUMBER}
                export STREAMLIT_IMAGE_TAG=${BUILD_NUMBER}

                mkdir -p /tmp/k8s

                for file in kubernetes/*.yaml; do
                    envsubst < "$file" > "/tmp/k8s/$(basename "$file")"
                done

                kubectl apply -f /tmp/k8s/

                echo
                echo "Waiting for Rollout..."

                kubectl rollout status deployment/${K8S_DEPLOYMENT} \
                    -n ${K8S_NAMESPACE}

                kubectl rollout status deployment/${K8S_STREAMLIT_DEPLOYMENT} \
                    -n ${K8S_NAMESPACE}

                '''

            }

        }

        stage('Verify Deployment') {

            steps {

                sh '''

                echo "Pods"

                kubectl get pods \
                -n ${K8S_NAMESPACE}

                echo

                echo "Services"

                kubectl get svc \
                -n ${K8S_NAMESPACE}

                echo

                echo "Deployments"

                kubectl get deployment \
                -n ${K8S_NAMESPACE}

                '''
            }
        }

    }

    post {

        success {

            echo "Pipeline Completed Successfully!"

        }

        failure {

            echo "Pipeline Failed!"

        }

        always {

            cleanWs()

        }
    }

}
