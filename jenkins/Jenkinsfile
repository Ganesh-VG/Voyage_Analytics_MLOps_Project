pipeline {

    agent any

    environment {

        AIRFLOW_URL = "http://localhost:8080/api/v1"

        DAG_ID = "travel_pipeline"

        API_IMAGE = "voyage-api:latest"

        K8S_NAMESPACE = "voyage-analytics"

        K8S_DEPLOYMENT = "voyage-api"

        K8S_SERVICE = "voyage-api-service"
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {

        stage('Checkout Source') {
            steps {
                checkout scm
            }
        }

        stage('Project Information') {
            steps {
                sh '''
                echo "========================================="
                echo "Voyage Analytics MLOps Pipeline"
                echo "========================================="

                echo "Workspace : $(pwd)"
                echo "Branch    : ${BRANCH_NAME}"
                echo "Build No  : ${BUILD_NUMBER}"
                echo "Image     : ${API_IMAGE}"

                echo
                docker --version
                kubectl version --client
                minikube version
                '''
            }
        }

        stage('Trigger Airflow DAG') {
            steps {
                sh '''
                echo "Triggering Airflow DAG..."

                curl -X POST \
                ${AIRFLOW_URL}/dags/${DAG_ID}/dagRuns \
                -H "Content-Type: application/json" \
                -u airflow:airflow \
                -d '{}'
                '''
            }
        }

        stage('Wait for DAG Completion') {
            steps {

                script {

                    timeout(time: 30, unit: 'MINUTES') {

                        waitUntil {

                            def status = sh(
                                script: '''
                                curl -s \
                                -u airflow:airflow \
                                ${AIRFLOW_URL}/dags/${DAG_ID}/dagRuns \
                                | jq -r '.dag_runs[0].state'
                                ''',
                                returnStdout: true
                            ).trim()

                            echo "Current DAG State : ${status}"

                            if(status == "success") {
                                return true
                            }

                            if(status == "failed") {
                                error("Airflow DAG Failed")
                            }

                            sleep 20

                            return false
                        }
                    }
                }
            }
        }

        stage('Build API Docker Image') {
            steps {

                sh '''
                echo "Building Docker Image..."

                docker build \
                    -t ${API_IMAGE} \
                    ./api

                docker images | grep voyage-api
                '''
            }
        }

        stage('Load Image into Minikube') {

            steps {

                sh '''
                echo "Loading Image into Minikube..."

                minikube image load ${API_IMAGE}
                '''
            }
        }

        stage('Deploy to Kubernetes') {

            steps {

                sh '''
                echo "Deploying Kubernetes Resources..."

                kubectl apply -f kubernetes/

                kubectl rollout status deployment/${K8S_DEPLOYMENT} \
                -n ${K8S_NAMESPACE}
                '''
            }
        }

        stage('Verify Deployment') {

            steps {

                sh '''
                echo "Pods"

                kubectl get pods \
                -n ${K8S_NAMESPACE}

                echo

                echo "Services"

                kubectl get svc \
                -n ${K8S_NAMESPACE}

                echo

                echo "Deployment"

                kubectl get deployment \
                -n ${K8S_NAMESPACE}

                echo

                echo "Application URL"

                minikube service ${K8S_SERVICE} \
                -n ${K8S_NAMESPACE} \
                --url
                '''
            }
        }

    }

    post {

        success {

            echo 'Pipeline Completed Successfully!'
        }

        failure {

            echo 'Pipeline Failed!'
        }

        always {

            cleanWs()
        }
    }
}